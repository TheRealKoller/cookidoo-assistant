# PostgreSQL Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/cookidoo_assistant_mcp
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=cookidoo_assistant_mcp
DATABASE_USER=cookidoo_user
DATABASE_PASSWORD=secure-password-here

# MCP Server Configuration
MCP_API_KEY=your-secure-api-key-here
PORT=3001

# Logging
LOG_LEVEL=info

# Node Environment
NODE_ENV=development

# Health Calculator Defaults
DEFAULT_PROTEIN_PERCENTAGE=30
DEFAULT_FAT_PERCENTAGE=30
DEFAULT_CARBS_PERCENTAGE=40
